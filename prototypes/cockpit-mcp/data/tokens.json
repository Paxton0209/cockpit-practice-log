      "$description": "Dark-mode value only in source; light value not yet extracted"
    },
    "popover-dark": {
      "$value": {
        "dark": "#141416"
      },
      "$description": "Dark-mode value only in source"
    }
  },
  "size": {
    "$type": "dimension",
    "status-bar-height": {
      "$value": "80px"
    },
    "status-bar-top-line": {
      "$value": "96px",
      "$description": "Speed, first nav item and first section header start under this line"
    },
    "dock-height": {
      "$value": "92px"
    },
    "row-min": {
      "$value": "76px",
      "$description": "size/row; side padding 32, vertical padding 16"
    },
    "text-line": {
      "$value": "38px"
    },
    "switch": {
      "$value": "52x32px",
      "$description": "knob 24"
    },
    "track": {
      "$value": "64px",
      "$description": "segment 56 + inset 4"
    },
    "icon": {
      "$value": "48px",
      "$description": "glyph ~24–31, stroke 2; never rescale"
    },
    "icon-button": {
      "$value": "68px",
      "$description": "hit area comes from the box, not a bigger icon"
    },
    "app-tile-icon": {
      "$value": "54px"
    },
    "tile-icon": {
      "$value": "72px"
    },
    "chevron-box": {
      "$value": "38px"
    },
    "info-icon": {
      "$value": "24px"
    },
    "button-label-min-M": {
      "$value": "116px"
    },
    "button-label-min-S": {
      "$value": "100px"
    },
    "search-field": {
      "$value": "560x76px",
      "$description": "radius 20, icon stroke 3, leading inset 20, icon-text gap 12"
    },
    "tile-button": {
      "$value": "250px",
      "$description": "3 per row, gap space/12"
    }
  },
  "radius": {
    "$type": "dimension",
    "card": {
      "$value": "20px"
    },
    "track": {
      "$value": "16px"
    },
    "segment": {
      "$value": "12px"
    },
    "tile": {
      "$value": "14px"
    }
  },
  "space": {
    "$type": "dimension",
    "10": {
      "$value": "10px"
    },
    "12": {
      "$value": "12px"
    },
    "24": {
      "$value": "24px"
    },
    "32": {
      "$value": "32px"
    },
    "38": {
      "$value": "38px"
    },
    "48": {
      "$value": "48px"
    }
  },
  "type": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "40px",
        "lineHeight": "48px"
      }
    },
    "title": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "28px",
        "lineHeight": "36px"
      }
    },
    "value": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "36px",
        "lineHeight": "48px"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "22px",
        "lineHeight": "30px"
      }
    },
    "body-l": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "28px",
        "lineHeight": "38px"
      },
      "$description": "Settings row title (Medium) and value (Regular)"
    },
    "body-m": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "26px",
        "lineHeight": "36px"
      },
      "$description": "Segment label inside a track"
    },
    "caption": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "24px",
        "lineHeight": "32px"
      },
      "$description": "Section header, helper text"
    },
    "number-l": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "48px"
      }
    },
    "dialog-title": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "36px",
        "lineHeight": "44px"
      }
    },
    "dialog-body": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "28px",
        "lineHeight": "36px"
      }
    }
  },
  "state": {
    "$type": "number",
    "pressed-opacity": {
      "$value": 0.7
    },
    "disabled-opacity": {
      "$value": 0.4,
      "$description": "Also for actions locked while driving"
    }
  },
  "layout": {
    "golden-split": {
      "$type": "number",
      "$value": 0.382,
      "$description": "Scene panel : app panel ≈ 740 : 1180 (settings) / 617 : 983 (key screen)"
    }
  }
}