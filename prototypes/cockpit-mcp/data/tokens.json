        "light": "#007aff",
        "dark": "#0a84ff"
      }
    },
    "map-route-traveled": {
      "$value": {
        "light": "#9aa0a9",
        "dark": "#5a5e66"
      }
    },
    "map-puck": {
      "$value": {
        "light": "#ffffff",
        "dark": "#ffffff"
      }
    },
    "map-water": {
      "$value": {
        "light": "#c9dcef",
        "dark": "#0f1a26"
      }
    },
    "map-park": {
      "$value": {
        "light": "#dcebdf",
        "dark": "#121a17"
      }
