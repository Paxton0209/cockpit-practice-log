{
  "$schema": "https://www.designtokens.org/TR/2025.10/format/",
  "$description": "Cockpit tokens extracted from Figma 'Guideline' (Key A Dark/Light). Values in px at the 1600x900 key-screen canvas unless noted.",
  "color": {
    "$type": "color",
    "foreground": {
      "$value": {
        "light": "#1d1d1f",
        "dark": "#ffffff"
      }
    },
    "muted-foreground": {
      "$value": {
        "light": "rgba(29,29,31,0.65)",
        "dark": "#ffffff99"
      }
    },
    "card": {
      "$value": {
        "light": "#ffffff",
        "dark": "#1c1c1e"
      }
    },
    "bg-screen": {
      "$value": {
        "light": "#e4e7ec",
        "dark": "#000000"
      }
    },
    "icon-primary": {
      "$value": {
        "light": "#1d1d1f",
        "dark": "#ffffff"
      }
    },
    "accent-fill": {
      "$value": {
        "light": "#007AFF",
        "dark": "#0C6FD2"
      },
      "$description": "Dimmer in dark so it does not glare (blue/500 light, blue/600 dark)"
    },
    "accent-fill-edge": {
      "$value": {
        "light": "#409CFF",
        "dark": "#0A84FF"
      },
      "$description": "One step brighter than the fill; 2 px inside on solid-accent selected only"
    },
    "primary-foreground": {
      "$value": {
        "light": "#ffffff",
        "dark": "#ffffff"
      }
    },
    "overlay-scene": {
      "$value": {
        "light": "#ffffff26",
        "dark": "#ffffff26"
      }
    },
    "overlay-scene-fade-100": {
      "$value": {
        "light": "#ffffffa6",
        "dark": "#00000080"
      },
      "$description": "Bar scrim: white 65% by day, black 50% at night"
    },
    "overlay-scene-fade-50": {
      "$value": {
        "light": "#ffffff53",
        "dark": "#00000040"
      }
    },
    "overlay-scene-fade-0": {
      "$value": {
        "light": "#ffffff00",
        "dark": "#00000000"
      }
